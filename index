}

/* MATH LAB ENGINE */
function factorize(n) {
  const factors = [];
  let d = 2;
  while (d * d <= n) {
    if (n % d === 0) {
      let count = 0;
      while (n % d === 0) {
        n /= d;
        count++;
      }
      factors.push([d, count]);
    }
    d++;
  }
  if (n > 1) factors.push([n, 1]);
  return factors;
}

function getDivisors(n) {
  const divs = [];
  for (let i = 1; i * i <= n; i++) {
    if (n % i === 0) {
      divs.push(i);
      if (i * i !== n) divs.push(n / i);
    }
  }
  return divs.sort((a, b) => a - b);
}

function calcPhi(n, factors) {
  if (n === 1) return 1;
  let res = n;
  for (const [p] of factors) {
    res = (res / p) * (p - 1);
  }
  return res;
}

function calcTau(factors) {
  return factors.reduce((acc, [, a]) => acc * (a + 1), 1);
}

function calcSigma(factors) {
  return factors.reduce((acc, [p, a]) => acc * ((Math.pow(p, a + 1) - 1) / (p - 1)), 1);
}

function calcMu(factors) {
  if (factors.some(([, a]) => a > 1)) return 0;
  return factors.length % 2 === 0 ? 1 : -1;
}

function setLabN(v) {
  document.getElementById('calcInput').value = v;
  updateLab();
}

function updateLab() {
  const input = document.getElementById('calcInput');
  let n = parseInt(input.value);
  if (isNaN(n) || n < 1) n = 1;
  if (n > 99999) n = 99999;

  const factors = factorize(n);
  const divs = getDivisors(n);

  let canonicalStr = '';
  if (n === 1) {
    canonicalStr = '1 (ไม่มีตัวประกอบเฉพาะ)';
  } else {
    canonicalStr = factors.map(([p, a]) => a === 1 ? `${p}` : `${p}<sup>${a}</sup>`).join(' × ');
  }
  document.getElementById('canonicalDisplay').innerHTML = `${n} = ${canonicalStr}`;

  const phi = calcPhi(n, factors);
  const tau = calcTau(factors);
  const sigma = calcSigma(factors);
  const mu = calcMu(factors);

  document.getElementById('valPhi').innerText = phi;
  document.getElementById('valTau').innerText = tau;
  document.getElementById('valSigma').innerText = sigma;
  document.getElementById('valMu').innerText = mu;

  document.getElementById('divCount').innerText = divs.length;
  document.getElementById('divList').innerHTML = divs.map(d => `
    <span class="badge-pill" style="font-size:0.9rem; background:var(--surface); border:1px solid var(--line);">${d}</span>
  `).join('');
}

/* ANALYTICS */
function renderAnalytics() {
  const preCorrect = Object.values(preAnswers).filter(a => a.isCorrect).length;
  const preDone = Object.keys(preAnswers).length;
  const postCorrect = Object.values(postAnswers).filter(a => a.isCorrect).length;
  const postDone = Object.keys(postAnswers).length;

  document.getElementById('metricPreScore').innerText = `${preCorrect} / 14`;
  document.getElementById('metricPrePct').innerText = preDone > 0 ? `ทำเสร็จแล้ว ${preDone} ข้อ (${Math.round((preCorrect/14)*100)}%)` : 'ยังไม่ได้เริ่มทำ';

  document.getElementById('metricPostScore').innerText = `${postCorrect} / 15`;
  document.getElementById('metricPostPct').innerText = postDone > 0 ? `ทำเสร็จแล้ว ${postDone} ข้อ (${Math.round((postCorrect/15)*100)}%)` : 'ยังไม่ได้เริ่มทำ';

  const preRate = preDone > 0 ? (preCorrect / 14) * 100 : 0;
  const postRate = postDone > 0 ? (postCorrect / 15) * 100 : 0;
  const delta = Math.round(postRate - preRate);

  const deltaEl = document.getElementById('metricDelta');
  deltaEl.innerText = `${delta >= 0 ? '+' : ''}${delta}%`;
  deltaEl.style.color = delta >= 0 ? 'var(--primary)' : 'var(--accent-red)';

  let diag = '';
  if (preDone === 0 && postDone === 0) {
    diag = 'ยังไม่พบข้อมูลการทำแบบทดสอบ แนะนำให้เริ่มทำแบบทดสอบในแท็บ <b>"1. ก่อนเรียน"</b> เพื่อเช็กจุดดักพื้นฐานก่อน จากนั้นเข้าสู่ห้องทดลอง และทดสอบในแท็บ <b>"3. หลังเรียน"</b> ครับ';
  } else {
    diag = `คุณทำแบบทดสอบก่อนเรียนได้ <b>${preCorrect} จาก 14 ข้อ</b> และทำแบบทดสอบหลังเรียนได้ <b>${postCorrect} จาก 15 ข้อ</b> `;
    if (delta > 0) {
      diag += `🎉 ยอดเยี่ยมมาก! คุณมีพัฒนาการเพิ่มขึ้น <b>${delta}%</b> แสดงว่าเข้าใจมโนทัศน์ของฟังก์ชันเลขคณิตและการแก้จุดดักในข้อสอบ สอวน. ได้ดียิ่งขึ้น`;
    } else if (postDone > 0) {
      diag += `💡 แนะนำให้ทบทวนข้อที่เป็นระดับ "สอวน.บอส" เช่น เอกลักษณ์ของเกาส์ (∑ φ(d) = n) และการหาค่าที่เป็นไปไม่ได้ของ φ(n) เพื่อเพิ่มความแม่นยำยิ่งขึ้น`;
    }
  }
  document.getElementById('analyticsDiagnosis').innerHTML = diag;
}

function clearAllScores() {
  if (confirm('คุณต้องการล้างประวัติการตอบคำถามทั้งก่อนเรียนและหลังเรียนหรือไม่?')) {
    preAnswers = {};
    postAnswers = {};
    localStorage.removeItem('nt_pre_ans');
    localStorage.removeItem('nt_post_ans');
    renderAnalytics();
  }
}

/* THEME */
const themeBtn = document.getElementById('themeToggleBtn');
const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
let appTheme = localStorage.getItem('nt_hub_theme') || (prefersDark ? 'dark' : 'light');

function setAppTheme(t) {
  document.documentElement.setAttribute('data-theme', t);
  document.getElementById('themeText').innerText = t === 'dark' ? 'โหมดมืด' : 'โหมดสว่าง';
  localStorage.setItem('nt_hub_theme', t);
}

themeBtn.addEventListener('click', () => {
  appTheme = appTheme === 'dark' ? 'light' : 'dark';
  setAppTheme(appTheme);
});

setAppTheme(appTheme);
setStage('pre');
</script>

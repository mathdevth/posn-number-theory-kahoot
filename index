let currentStage = 'pre'; // 'pre' | 'lab' | 'post' | 'analytics'
let currentView = 'teacher'; // 'teacher' | 'student' | 'table'
let searchQuery = '';

let preAnswers = JSON.parse(localStorage.getItem('nt_pre_ans') || '{}');
let postAnswers = JSON.parse(localStorage.getItem('nt_post_ans') || '{}');

function getActiveQuestions() {
  return currentStage === 'pre' ? PRE_DATA : POST_DATA;
}

function setStage(stage) {
  currentStage = stage;
  document.querySelectorAll('.stage-tab-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.stage === stage);
  });

  const subNav = document.getElementById('subControls');
  const qSec = document.getElementById('questionsSection');
  const labSec = document.getElementById('labSection');
  const anaSec = document.getElementById('analyticsSection');
  const tblView = document.getElementById('tableView');

  if (stage === 'pre' || stage === 'post') {
    subNav.style.display = 'flex';
    if (currentView === 'table') {
      qSec.style.display = 'none';
      tblView.style.display = 'block';
    } else {
      qSec.style.display = 'block';
      tblView.style.display = 'none';
    }
    labSec.style.display = 'none';
    anaSec.style.display = 'none';
    renderQuestions();
  } else if (stage === 'lab') {
    subNav.style.display = 'none';
    qSec.style.display = 'none';
    tblView.style.display = 'none';
    labSec.style.display = 'block';
    anaSec.style.display = 'none';
    updateLab();
  } else if (stage === 'analytics') {
    subNav.style.display = 'none';
    qSec.style.display = 'none';
    tblView.style.display = 'none';
    labSec.style.display = 'none';
    anaSec.style.display = 'block';
    renderAnalytics();
  }
}

function setViewMode(view) {
  currentView = view;
  document.querySelectorAll('.mode-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.view === view);
  });

  const qSec = document.getElementById('questionsSection');
  const tblView = document.getElementById('tableView');

  if (view === 'table') {
    qSec.style.display = 'none';
    tblView.style.display = 'block';
    renderTable();
  } else {
    qSec.style.display = 'block';
    tblView.style.display = 'none';
    renderQuestions();
  }
}

function handleSearch() {
  searchQuery = document.getElementById('filterInput').value.trim().toLowerCase();
  if (currentView === 'table') {
    renderTable();
  } else {
    renderQuestions();
  }
}

function copyScript(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    const old = btn.innerText;
    btn.innerText = '✓ คัดลอกแล้ว!';
    btn.style.background = 'var(--primary)';
    btn.style.color = '#fff';
    setTimeout(() => {
      btn.innerText = old;
      btn.style.background = '';
      btn.style.color = '';
    }, 2000);
  });
}

function onAnswerSelect(qId, choiceIdx, isCorrect) {
  const store = currentStage === 'pre' ? preAnswers : postAnswers;
  if (store[qId] !== undefined) return;
  store[qId] = { choiceIdx, isCorrect };
  
  if (currentStage === 'pre') {
    localStorage.setItem('nt_pre_ans', JSON.stringify(preAnswers));
  } else {
    localStorage.setItem('nt_post_ans', JSON.stringify(postAnswers));
  }

  renderQuestions();
}

function renderQuestions() {
  const questions = getActiveQuestions();
  const store = currentStage === 'pre' ? preAnswers : postAnswers;
  const isStudent = currentView === 'student';
  const container = document.getElementById('cardsList');

  const filtered = questions.filter(item => {
    if (!searchQuery) return true;
    return item.q.toLowerCase().includes(searchQuery) ||
           item.ans.toLowerCase().includes(searchQuery) ||
           item.math_proof.toLowerCase().includes(searchQuery) ||
           item.trap.toLowerCase().includes(searchQuery) ||
           item.script.toLowerCase().includes(searchQuery);
  });

  if (filtered.length === 0) {
    container.innerHTML = `
      <div style="background:var(--surface); border:1.5px dashed var(--line); border-radius:var(--radius-lg); padding:40px; text-align:center; color:var(--ink-secondary);">
        <h3>🔍 ไม่พบข้อคำถามที่ตรงกับคำค้นหา</h3>
      </div>
    `;
    return;
  }

  const shapes = { red: '▲', blue: '◆', yellow: '●', green: '■' };

  container.innerHTML = filtered.map(item => {
    const answered = store[item.id];

    const choicesHtml = item.choices.map((c, idx) => {
      if (!isStudent) {
        return `
          <div class="c-item ${c.color} ${c.correct ? 'is-correct' : ''}">
            <span style="width:20px;">${shapes[c.color]}</span>
            <span>${c.text}</span>
            ${c.correct ? '<span class="c-indicator">✓ ถูกต้อง</span>' : ''}
          </div>
        `;
      } else {
        let extra = '';
        if (answered) {
          if (c.correct) extra = 'is-correct';
          else if (answered.choiceIdx === idx) extra = 'wrong-choice';
        }
        return `
          <button class="c-item student-choice-btn ${c.color} ${extra}"
                  onclick="onAnswerSelect('${item.id}', ${idx}, ${c.correct})"
                  ${answered ? 'disabled' : ''}>
            <span style="width:20px;">${shapes[c.color]}</span>
            <span>${c.text}</span>
            ${answered && c.correct ? '<span class="c-indicator">✓ คำตอบที่ถูก</span>' : ''}
          </button>
        `;
      }
    }).join('');

    let detailsHtml = '';
    if (!isStudent || answered) {
      detailsHtml = `
        <div class="box-duo">
          <div class="box-info proof">
            <h4>🧠 เหตุผลทางคณิตศาสตร์ & บทพิสูจน์</h4>
            <div>${item.math_proof}</div>
          </div>
          <div class="box-info trap">
            <h4>⚠️ จุดดักมหาชน & ข้อควรระวัง</h4>
            <div>${item.trap}</div>
          </div>
        </div>
        <div class="script-box">
          <div class="script-bar">
            <h4>🎙️ สคริปต์คำพูดครูใส่ไมค์ (แก้ความง่วง)</h4>
            <button class="btn-copy" onclick="copyScript('${item.script.replace(/'/g, "\\'") }', this)">📋 คัดลอกบทพูด</button>
          </div>
          <p class="script-quote">“${item.script}”</p>
        </div>
      `;
    } else {
      detailsHtml = `
        <div style="background:var(--surface-subtle); border-radius:var(--radius-md); padding:14px; text-align:center; color:var(--ink-secondary); font-size:0.92rem;">
          👆 แตะเลือกคำตอบด้านบนเพื่อตรวจและเปิดเฉลยละเอียดทันที
        </div>
      `;
    }

    return `
      <div class="q-card">
        <div class="q-card-head">
          <div class="q-badge-cluster">
            <div class="q-index">${item.num}</div>
            <span class="badge-pill" style="border-color:${item.tag_color}; color:${item.tag_color};">#${item.tag}</span>
            <span class="badge-pill time">⏱️ ${item.time}</span>
          </div>
          <span style="font-size:0.85rem; font-weight:700; color:var(--ink-secondary);">
            ${currentStage === 'pre' ? '📘 ก่อนเรียน (Pre-test)' : '📙 หลังเรียน (Post-test)'}
          </span>
        </div>
        <h3 class="q-title">${item.q}</h3>
        <div class="choices-row">${choicesHtml}</div>
        ${detailsHtml}
      </div>
    `;
  }).join('');
}


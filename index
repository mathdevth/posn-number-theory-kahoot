<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ศูนย์การเรียนรู้ทฤษฎีจำนวน: ก่อนเรียน & หลังเรียน สอวน.คณิตศาสตร์</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap">
<style>
:root {
  --bg: #F4F7FB;
  --surface: #FFFFFF;
  --surface-subtle: #EEF3F8;
  --ink: #101E33;
  --ink-secondary: #4B5A73;
  --line: #CFDAE6;
  --line-light: #E2EAF2;
  --primary: #0A7567;
  --primary-bg: #E3F6F2;
  --primary-dark: #065449;
  --accent-gold: #B07800;
  --accent-gold-bg: #FFF5D6;
  --accent-red: #D32F2F;
  --accent-red-bg: #FDE8E8;
  --accent-blue: #1976D2;
  --accent-blue-bg: #E3F2FD;
  --accent-purple: #6B4FD8;
  --accent-purple-bg: #F0ECFC;
  --kahoot-red: #E21B3C;
  --kahoot-blue: #1368CE;
  --kahoot-yellow: #D89E00;
  --kahoot-green: #26890C;
  --radius-lg: 16px;
  --radius-md: 10px;
  --radius-sm: 6px;
  --shadow: 0 4px 18px rgba(16,30,51,0.06);
  --shadow-hover: 0 8px 28px rgba(16,30,51,0.12);
}

[data-theme="dark"] {
  --bg: #0C1424;
  --surface: #142138;
  --surface-subtle: #1C2D4A;
  --ink: #EAF0FA;
  --ink-secondary: #A0B2CD;
  --line: #2B3D5E;
  --line-light: #20314E;
  --primary: #38D9BA;
  --primary-bg: #0C332D;
  --primary-dark: #2BB399;
  --accent-gold: #F5BC38;
  --accent-gold-bg: #3D2F0B;
  --accent-red: #FF6659;
  --accent-red-bg: #3E1816;
  --accent-blue: #64B5F6;
  --accent-blue-bg: #102A45;
  --accent-purple: #A78BFA;
  --accent-purple-bg: #281F4B;
  --shadow: 0 4px 18px rgba(0,0,0,0.3);
  --shadow-hover: 0 8px 28px rgba(0,0,0,0.5);
}

*, *::before, *::after { box-sizing: border-box; }
body {
  margin: 0;
  padding: 0;
  background-color: var(--bg);
  color: var(--ink);
  font-family: "IBM Plex Sans Thai", system-ui, sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4, .heading-font, button, .chakra {
  font-family: "Chakra Petch", "IBM Plex Sans Thai", sans-serif;
}

.app-container {
  max-width: 1160px;
  margin: 0 auto;
  padding: 24px 20px 80px;
}

/* Header Banner */
header.hero-header {
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 28px;
  margin-bottom: 24px;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}
header.hero-header::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6px;
  background: linear-gradient(90deg, #E21B3C, #1368CE, #D89E00, #26890C);
}
.header-flex {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18px;
  flex-wrap: wrap;
}
.header-info h1 {
  font-size: clamp(1.6rem, 4vw, 2.3rem);
  margin: 0 0 6px;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.badge-tag {
  font-size: 0.85rem;
  background: var(--primary-bg);
  color: var(--primary);
  padding: 4px 14px;
  border-radius: 999px;
  border: 1px solid var(--primary);
  font-weight: 700;
}
.header-desc {
  color: var(--ink-secondary);
  margin: 0 0 16px;
  max-width: 76ch;
  font-size: 1.05rem;
}
.header-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}
.btn-kahoot {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 16px;
  border-radius: var(--radius-md);
  text-decoration: none;
  font-weight: 700;
  font-size: 0.95rem;
  transition: all 0.2s;
  color: #fff;
  border: none;
}
.btn-kahoot.pre { background: #46178F; }
.btn-kahoot.pre:hover { background: #35106E; transform: translateY(-2px); }
.btn-kahoot.post { background: #0A7567; }
.btn-kahoot.post:hover { background: #07564C; transform: translateY(-2px); }

.btn-ctrl {
  background: var(--surface-subtle);
  border: 1.5px solid var(--line);
  color: var(--ink);
  padding: 8px 14px;
  border-radius: var(--radius-md);
  cursor: pointer;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.15s;
}
.btn-ctrl:hover {
  background: var(--accent-gold-bg);
  border-color: var(--accent-gold);
}

/* Stage Indicator Bar (ก่อนเรียน -> ห้องทดลอง -> หลังเรียน -> สรุปพัฒนาการ) */
.stage-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-bottom: 24px;
}
@media (max-width: 768px) {
  .stage-bar { grid-template-columns: repeat(2, 1fr); }
}
.stage-tab-btn {
  background: var(--surface);
  border: 2px solid var(--line);
  border-radius: var(--radius-md);
  padding: 14px 12px;
  cursor: pointer;
  text-align: left;
  display: flex;
  align-items: center;
  gap: 12px;
  transition: all 0.2s;
  box-shadow: var(--shadow);
}
.stage-tab-btn:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
}
.stage-tab-btn.active {
  border-color: var(--primary);
  background: var(--primary-bg);
  box-shadow: 0 4px 16px rgba(10,117,103,0.15);
}
.stage-icon {
  font-size: 1.6rem;
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  background: var(--surface-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.stage-tab-btn.active .stage-icon {
  background: #FFFFFF;
}
[data-theme="dark"] .stage-tab-btn.active .stage-icon {
  background: var(--surface);
}
.stage-meta strong {
  display: block;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--ink);
}
.stage-meta span {
  font-size: 0.85rem;
  color: var(--ink-secondary);
}

/* Secondary Action Sub-nav (โหมดครูผู้สอน / โหมดนักเรียน / ตารางย่อ) */
.sub-nav {
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-md);
  padding: 12px 18px;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}
.mode-switch-group {
  display: flex;
  background: var(--surface-subtle);
  padding: 4px;
  border-radius: var(--radius-sm);
  gap: 4px;
  border: 1px solid var(--line);
}
.mode-btn {
  border: none;
  background: transparent;
  color: var(--ink-secondary);
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.15s;
}
.mode-btn.active {
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 2px 6px rgba(0,0,0,0.06);
}
.filter-search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  max-width: 380px;
}
.filter-search-box input {
  width: 100%;
  padding: 7px 12px;
  border: 1.5px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--surface-subtle);
  color: var(--ink);
  font-size: 0.9rem;
}
.filter-search-box input:focus {
  outline: 2px solid var(--primary);
  background: var(--surface);
}

/* Score / Progress Tracker Card */
.analytics-card {
  background: linear-gradient(135deg, var(--surface) 0%, var(--surface-subtle) 100%);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 24px;
  margin-bottom: 24px;
  box-shadow: var(--shadow);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  text-align: center;
}
@media (max-width: 768px) {
  .analytics-card { grid-template-columns: 1fr; }
}
.metric-box {
  padding: 16px;
  border-radius: var(--radius-md);
  background: var(--surface);
  border: 1px solid var(--line-light);
}
.metric-box h3 {
  margin: 0 0 6px;
  font-size: 0.95rem;
  color: var(--ink-secondary);
}
.metric-box .metric-val {
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.1;
}
.metric-box .metric-note {
  font-size: 0.85rem;
  color: var(--ink-secondary);
  margin-top: 4px;
}

/* Cards Container */
.cards-flow {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.q-card {
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow);
  transition: transform 0.2s, box-shadow 0.2s;
}
.q-card:hover {
  box-shadow: var(--shadow-hover);
}
.q-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}
.q-badge-cluster {
  display: flex;
  align-items: center;
  gap: 8px;
}
.q-index {
  font-size: 1.25rem;
  font-weight: 700;
  background: var(--surface-subtle);
  color: var(--ink);
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  border: 1.5px solid var(--line);
}
.badge-pill {
  font-size: 0.8rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
  background: var(--surface-subtle);
}
.badge-pill.time {
  background: var(--accent-gold-bg);
  color: var(--accent-gold);
  border-color: var(--accent-gold);
}
.q-title {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 16px;
  line-height: 1.45;
}

/* Choices Layout */
.choices-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 18px;
}
@media (max-width: 600px) {
  .choices-row { grid-template-columns: 1fr; }
}
.c-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 1.05rem;
  border: 2px solid transparent;
  color: #FFFFFF;
  position: relative;
}
.c-item.red { background: var(--kahoot-red); }
.c-item.blue { background: var(--kahoot-blue); }
.c-item.yellow { background: var(--kahoot-yellow); }
.c-item.green { background: var(--kahoot-green); }

.c-item.is-correct {
  border-color: #FFFFFF;
  box-shadow: 0 0 0 3px #10B981, inset 0 0 0 1px rgba(0,0,0,0.15);
}
.c-indicator {
  margin-left: auto;
  background: rgba(255,255,255,0.95);
  color: #065449;
  font-size: 0.85rem;
  padding: 2px 8px;
  border-radius: 999px;
  font-weight: 700;
}

/* Student quiz buttons */
.student-choice-btn {
  width: 100%;
  border: none;
  cursor: pointer;
  text-align: left;
  transition: transform 0.15s, opacity 0.2s;
}
.student-choice-btn:hover:not(:disabled) {
  transform: scale(1.02);
  filter: brightness(1.08);
}
.student-choice-btn:disabled {
  cursor: default;
}
.student-choice-btn.wrong-choice {
  filter: grayscale(0.6) brightness(0.8);
  border: 3px solid #EF4444;
}

/* Info Boxes */
.box-duo {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 14px;
}
@media (max-width: 768px) {
  .box-duo { grid-template-columns: 1fr; }
}
.box-info {
  padding: 14px 16px;
  border-radius: var(--radius-md);
  font-size: 0.95rem;
  line-height: 1.55;
  border: 1.5px solid transparent;
}
.box-info h4 {
  margin: 0 0 6px;
  font-size: 0.95rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6px;
}
.box-info.proof {
  background: var(--accent-blue-bg);
  border-color: var(--accent-blue);
  color: var(--ink);
}
.box-info.proof h4 { color: var(--accent-blue); }
[data-theme="dark"] .box-info.proof h4 { color: #90CAF9; }

.box-info.trap {
  background: var(--accent-red-bg);
  border-color: var(--accent-red);
  color: var(--ink);
}
.box-info.trap h4 { color: var(--accent-red); }
[data-theme="dark"] .box-info.trap h4 { color: #FF8A80; }

/* Teacher Voice Bubble */
.script-box {
  background: var(--accent-gold-bg);
  border: 2px solid var(--accent-gold);
  border-radius: var(--radius-md);
  padding: 16px 18px;
}
.script-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}
.script-bar h4 {
  margin: 0;
  color: var(--accent-gold);
  font-size: 1rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6px;
}
[data-theme="dark"] .script-bar h4 { color: #F5BC38; }
.btn-copy {
  background: var(--surface);
  border: 1px solid var(--accent-gold);
  color: var(--ink);
  font-size: 0.8rem;
  padding: 3px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-weight: 600;
}
.btn-copy:hover {
  background: var(--accent-gold);
  color: #fff;
}
.script-quote {
  font-size: 1.05rem;
  font-style: italic;
  color: var(--ink);
  margin: 0;
  line-height: 1.6;
}

/* Interactive Lab Section (Section 2) */
.lab-card {
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 28px;
  margin-bottom: 24px;
  box-shadow: var(--shadow);
}
.calc-controls {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 20px;
}
.calc-input {
  font-size: 1.3rem;
  font-weight: 700;
  font-family: "Chakra Petch", sans-serif;
  padding: 8px 14px;
  border-radius: var(--radius-md);
  border: 2px solid var(--ink);
  background: var(--surface-subtle);
  color: var(--ink);
  width: 140px;
}
.quick-chips {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.quick-chip {
  background: var(--surface-subtle);
  border: 1px solid var(--line);
  padding: 6px 12px;
  border-radius: var(--radius-sm);
  font-weight: 600;
  cursor: pointer;
}
.quick-chip:hover {
  background: var(--primary-bg);
  border-color: var(--primary);
}
.calc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 24px;
}
@media (max-width: 768px) {
  .calc-grid { grid-template-columns: repeat(2, 1fr); }
}
.func-stat-card {
  background: var(--surface-subtle);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-md);
  padding: 16px;
  text-align: center;
  transition: transform 0.15s;
}
.func-stat-card:hover {
  transform: translateY(-3px);
  border-color: var(--primary);
}
.func-stat-card .symbol {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--ink-secondary);
}
.func-stat-card .val {
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
  margin: 4px 0;
}
.func-stat-card .desc {
  font-size: 0.85rem;
  color: var(--ink-secondary);
}

/* Theory Cards */
.theory-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
@media (max-width: 768px) {
  .theory-grid { grid-template-columns: 1fr; }
}
.theory-card {
  background: var(--surface-subtle);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 18px;
}
.theory-card h4 {
  margin: 0 0 8px;
  font-size: 1.1rem;
  color: var(--primary-dark);
}
[data-theme="dark"] .theory-card h4 { color: var(--primary); }
.formula-badge {
  display: inline-block;
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 4px 10px;
  border-radius: 6px;
  font-weight: 700;
  font-family: "Chakra Petch", monospace;
  margin: 4px 0 8px;
}

/* Matrix Table View */
.table-responsive {
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 20px;
  overflow-x: auto;
  box-shadow: var(--shadow);
}
table.summary-tbl {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}
table.summary-tbl th, table.summary-tbl td {
  border: 1px solid var(--line);
  padding: 10px 14px;
  text-align: left;
  vertical-align: top;
}
table.summary-tbl th {
  background: var(--surface-subtle);
  font-weight: 700;
  font-family: "Chakra Petch", sans-serif;
}
table.summary-tbl tr:hover {
  background: var(--surface-subtle);
}
.pill-ans {
  display: inline-block;
  background: var(--primary-bg);
  color: var(--primary-dark);
  border: 1px solid var(--primary);
  padding: 2px 8px;
  border-radius: 6px;
  font-weight: 700;
  white-space: nowrap;
}
[data-theme="dark"] .pill-ans { color: #38D9BA; }

/* Print Rules */
@media print {
  .header-actions, .stage-bar, .sub-nav, .btn-copy, .quick-chips, #calcInput { display: none !important; }
  body { background: #fff !important; color: #000 !important; }
  .q-card { page-break-inside: avoid; border: 1px solid #999 !important; box-shadow: none !important; margin-bottom: 20px; }
  .script-box { background: #fff9ea !important; border: 1px solid #B07800 !important; }
}
</style>
</head>
<body>

<div class="app-container">
  <!-- Hero Header -->
  <header class="hero-header">
    <div class="header-flex">
      <div class="header-info">
        <h1>
          <span>ศูนย์การเรียนรู้ทฤษฎีจำนวน (Number Theory Hub)</span>
          <span class="badge-tag">สอวน.คณิตศาสตร์</span>
        </h1>
        <p class="header-desc">
          ชุดเครื่องมือสำหรับ <b>"ก่อนเรียน" (Pre-test)</b> เพื่อเตรียมความพร้อม และ <b>"หลังเรียน" (Post-test)</b> เพื่อประเมินผลฟังก์ชันเลขคณิต (φ, τ, σ, μ) พร้อมห้องทดลองคำนวณและสคริปต์แก้ความง่วงสำหรับผู้สอน
        </p>
      </div>
      <div class="header-actions">
        <a href="https://create.kahoot.it/creator/3971c251-3f78-4d8b-913d-664a9c510215" target="_blank" rel="noopener" class="btn-kahoot pre">
          🚀 Kahoot! ก่อนเรียน
        </a>
        <a href="https://create.kahoot.it/creator/2a88c63a-5b47-46d4-be55-523fc5a27825" target="_blank" rel="noopener" class="btn-kahoot post">
          🔥 Kahoot! หลังเรียน
        </a>
        <button class="btn-ctrl" id="themeToggleBtn" title="สลับธีม สว่าง/มืด">
          🌓 <span id="themeText">ธีม</span>
        </button>
        <button class="btn-ctrl" onclick="window.print()" title="พิมพ์หรือบันทึกเป็น PDF">
          🖨️ พิมพ์
        </button>
      </div>
    </div>
  </header>

  <!-- 4-Stage Navigation Bar -->
  <div class="stage-bar">
    <button class="stage-tab-btn active" data-stage="pre" onclick="setStage('pre')">
      <div class="stage-icon">📘</div>
      <div class="stage-meta">
        <strong>1. ก่อนเรียน (Pre-test)</strong>
        <span>14 ข้อทดสอบ & จุดดักพื้นฐาน</span>
      </div>
    </button>
    <button class="stage-tab-btn" data-stage="lab" onclick="setStage('lab')">
      <div class="stage-icon">🧪</div>
